{
  "name": "@crowkis/client",
  "version": "0.5.2",
  "description": "Official Node.js and TypeScript SDK for Crowkis — intelligent, Redis-compatible cache & memory for LLM apps and agents",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./index.mjs", "require": "./index.js", "default": "./index.js" },
    "./agent": { "types": "./agent.d.ts", "default": "./agent.js" },
    "./voice": { "types": "./voice.d.ts", "default": "./voice.js" },
    "./realtime": { "types": "./realtime.d.ts", "default": "./realtime.js" },
    "./voiceTurns": { "types": "./voiceTurns.d.ts", "default": "./voiceTurns.js" },
    "./langchain": { "types": "./langchain.d.ts", "default": "./langchain.js" },
    "./memory": { "types": "./memory.d.ts", "default": "./memory.js" }
  },
  "license": "Apache-2.0",
  "author": "Mohit Rohilla",
  "keywords": ["crowkis", "llm", "cache", "semantic-cache", "agent-memory", "langchain", "langgraph", "redis"],
  "homepage": "https://www.crowkis.com",
  "repository": { "type": "git", "url": "https://github.com/crowkis/crowkis-sdk.git" },
  "peerDependencies": {
    "@grpc/grpc-js": ">=1.9.0",
    "@grpc/proto-loader": ">=0.7.0"
  },
  "peerDependenciesMeta": {
    "@grpc/grpc-js": {
      "optional": true
    },
    "@grpc/proto-loader": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "config.js",
    "agent.js",
    "voice.js",
    "realtime.js",
    "voiceTurns.js",
    "langchain.js",
    "memory.js",
    "grpc.js",
    "crowkis.proto",
    "index.mjs",
    "agent.d.ts",
    "voice.d.ts",
    "realtime.d.ts",
    "voiceTurns.d.ts",
    "langchain.d.ts",
    "memory.d.ts",
    "README.md"
  ],
  "scripts": {
    "check": "node --check index.js",
    "test": "node run-tests.js"
  }
}
