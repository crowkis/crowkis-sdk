# Copy to .env for local development (the real .env is gitignored, never committed).
# The SDK itself needs none of these — they're only for running the examples/tests
# against a local Crowkis server.

# Where your Crowkis server is running:
CROWKIS_HOST=127.0.0.1
CROWKIS_PORT=6383
CROWKIS_TENANT=dev

# Optional: an auth token if your server sets CROWKIS_AUTH_TOKEN.
# CROWKIS_TOKEN=

# Optional: an LLM key if you run the framework examples end-to-end.
# OPENAI_API_KEY=
