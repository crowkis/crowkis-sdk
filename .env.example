# Copy to .env for local development (the real .env is gitignored, never committed).
# Every SDK client reads these when it is created and no value is passed in code;
# a value passed in code always wins. With none set: 127.0.0.1:6383, no token or tenant.

# Where your Crowkis server is running:
CROWKIS_HOST=127.0.0.1
CROWKIS_PORT=6383

# Optional: put every client under one tenant (a value passed in code still wins).
# CROWKIS_TENANT=dev

# Optional: the server's token, if it sets CROWKIS_AUTH_TOKEN (CROWKIS_TOKEN also works).
# CROWKIS_AUTH_TOKEN=

# Or all of the above in one line (the separate variables win over its parts):
# CROWKIS_URL=crowkis://:token@127.0.0.1:6383/dev

# Optional: an LLM key if you run the framework examples end-to-end.
# OPENAI_API_KEY=
