{
  "name": "@crowkis/client",
  "version": "0.5.2",
  "description": "Official Node.js and TypeScript SDK for Crowkis \u2014 intelligent, Redis-compatible cache & memory for LLM apps and agents",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./index.mjs", "require": "./index.js", "default": "./index.js" },
    "./agent": { "types": "./agent.d.ts", "default": "./src/client/agent.js" },
    "./voice": { "types": "./voice.d.ts", "default": "./src/channels/voiceSession.js" },
    "./realtime": { "types": "./realtime.d.ts", "default": "./src/channels/realtime.js" },
    "./voiceTurns": { "types": "./voiceTurns.d.ts", "default": "./src/integrations/voiceTurns.js" },
    "./livekit": { "types": "./livekit.d.ts", "default": "./src/integrations/livekit.js" },
    "./langchain": { "types": "./langchain.d.ts", "default": "./src/integrations/langchain.js" },
    "./memory": { "types": "./memory.d.ts", "default": "./src/integrations/memory.js" },
    "./chat": { "types": "./chat.d.ts", "default": "./src/channels/chat.js" },
    "./session": { "types": "./session.d.ts", "default": "./src/channels/callSession.js" },
    "./privacy": { "types": "./privacy.d.ts", "default": "./src/privacy.js" },
    "./package.json": "./package.json"
  },
  "license": "Apache-2.0",
  "author": "Mohit Rohilla",
  "keywords": [
    "crowkis",
    "llm",
    "cache",
    "semantic-cache",
    "agent-memory",
    "langchain",
    "langgraph",
    "redis"
  ],
  "homepage": "https://www.crowkis.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/crowkis/crowkis-sdk.git"
  },
  "peerDependencies": {
    "@grpc/grpc-js": ">=1.9.0",
    "@grpc/proto-loader": ">=0.7.0"
  },
  "peerDependenciesMeta": {
    "@grpc/grpc-js": {
      "optional": true
    },
    "@grpc/proto-loader": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src/client/connection.js",
    "src/client/commands.js",
    "src/client/admin.js",
    "src/client/config.js",
    "src/client/agent.js",
    "src/client/grpc/grpc.js",
    "src/client/grpc/crowkis.proto",
    "src/integrations/langchain.js",
    "src/integrations/memory.js",
    "src/integrations/livekit.js",
    "src/channels/voiceSession.js",
    "src/channels/realtime.js",
    "src/integrations/voiceTurns.js",
    "langchain.d.ts",
    "memory.d.ts",
    "src/channels/chat.js",
    "src/channels/callSession.js",
    "src/rules/ruleChecker.js",
    "src/understanding/model/understanders.js",
    "src/understanding/model/frame.js",
    "src/state/callState.js",
    "index.mjs",
    "agent.d.ts",
    "voice.d.ts",
    "realtime.d.ts",
    "voiceTurns.d.ts",
    "livekit.d.ts",
    "chat.d.ts",
    "session.d.ts",
    "privacy.d.ts",
    "src/keys/knowledgeSegment.js",
    "src/privacy.js",
    "src/rules/chain.js",
    "src/rules/chatRuleSet.js",
    "src/rules/hit/hit.js",
    "src/rules/hit/index.js",
    "src/rules/question/context.js",
    "src/rules/question/index.js",
    "src/rules/question/personal.js",
    "src/rules/question/shape.js",
    "src/rules/question/urgent.js",
    "src/rules/ruleSet.js",
    "src/rules/save/callerSpecific.js",
    "src/rules/save/index.js",
    "src/rules/save/nothingToSave.js",
    "src/runtime/boundedWriter.js",
    "src/runtime/cacheLookup.js",
    "src/runtime/deadline.js",
    "src/runtime/questionRecords.js",
    "src/runtime/stats.js",
    "src/runtime/turnPairing.js",
    "src/runtime/writeResult.js",
    "src/turns/chat/checks.js",
    "src/turns/chat/steps.js",
    "src/turns/chat/turn.js",
    "src/turns/core.js",
    "src/turns/results.js",
    "src/turns/values.js",
    "src/turns/voice/call.js",
    "src/turns/voice/steps.js",
    "src/turns/voice/turn.js",
    "src/understanding/slots.js",
    "src/understanding/wordRules/chat.js",
    "src/understanding/model/checks.js",
    "src/understanding/wordRules/answers.js",
    "src/understanding/wordRules/callContext.js",
    "src/understanding/wordRules/followUp.js",
    "src/understanding/wordRules/personal.js",
    "src/understanding/wordRules/text.js",
    "src/understanding/wordRules/urgent.js",
    "README.md"
  ],
  "scripts": {
    "check": "node --check index.js",
    "test": "node run-tests.js",
    "typecheck": "tsc --noEmit --strict --module node16 --moduleResolution node16 --types node test-types.ts"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "typescript": "5.6.3"
  }
}
