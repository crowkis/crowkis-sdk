{
  "name": "@crowkis/client",
  "version": "0.5.2",
  "description": "Official Node.js and TypeScript SDK for Crowkis \u2014 intelligent, Redis-compatible cache & memory for LLM apps and agents",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./index.mjs", "require": "./index.js", "default": "./index.js" },
    "./agent": { "types": "./agent.d.ts", "default": "./agent.js" },
    "./voice": { "types": "./voice.d.ts", "default": "./src/channels/voiceSession.js" },
    "./realtime": { "types": "./realtime.d.ts", "default": "./src/channels/realtime.js" },
    "./voiceTurns": { "types": "./voiceTurns.d.ts", "default": "./src/integrations/voiceTurns.js" },
    "./livekit": { "types": "./livekit.d.ts", "default": "./livekit.js" },
    "./langchain": { "types": "./langchain.d.ts", "default": "./langchain.js" },
    "./memory": { "types": "./memory.d.ts", "default": "./memory.js" },
    "./chat": { "types": "./chat.d.ts", "default": "./src/channels/chat.js" },
    "./session": { "types": "./session.d.ts", "default": "./src/channels/callSession.js" },
    "./privacy": { "types": "./privacy.d.ts", "default": "./src/privacy.js" },
    "./package.json": "./package.json"
  },
  "license": "Apache-2.0",
  "author": "Mohit Rohilla",
  "keywords": [
    "crowkis",
    "llm",
    "cache",
    "semantic-cache",
    "agent-memory",
    "langchain",
    "langgraph",
    "redis"
  ],
  "homepage": "https://www.crowkis.com",
  "repository": {
    "type": "git",
